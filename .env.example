# Copy to `.env` and fill in. Never commit `.env`.
# All VITE_* values are bundled into the client at build time — they are
# public by design. Do NOT put real secrets here.

# --- Supabase (required) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback, only if you're still on the old anon key:
# VITE_SUPABASE_ANON_KEY=

# --- Optional: app degrades gracefully when unset ---
# Real Stripe checkout; without it the app runs in demo mode.
# VITE_STRIPE_PUBLISHABLE_KEY=
# Mapbox tiles; without it the map falls back to a default style.
# VITE_MAPBOX_TOKEN=

# --- Server-side secrets: set via `supabase secrets set`, never in this file ---
#   ANTHROPIC_API_KEY
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET
